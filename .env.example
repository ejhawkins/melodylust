# Contentful. Server-side only: never give these a VITE_ prefix. On Vercel, set them under Project → Settings →
# Environment Variables. Locally, put them in .env.local (ignored by git), not in .env (which git tracks).
CONTENTFUL_SPACE_ID=
# Content Delivery API token (not the Preview token). The site reads stories, good reads, song looks and the runway
# archive with it. CONTENTFUL_DELIVERY_TOKEN is accepted as another name for the same token.
CONTENTFUL_API_KEY=
# Optional: an environment other than master, and a gateway in place of cdn.contentful.com.
CONTENTFUL_ENVIRONMENT=
CONTENTFUL_API_URL=
# Only for the scripts in scripts/contentful/ that create content types and entries. Never set this on Vercel.
CONTENTFUL_MANAGEMENT_TOKEN=

# Spotify Web API (developer.spotify.com → your app → Basic Information). Server-side only: never give these a VITE_
# prefix. On Vercel, set them under Project → Settings → Environment Variables; locally, in .env.local (ignored by git).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The listening room's full-song playback (docs/spotify-listening-room.md) does not use the client secret: it signs in
# with PKCE. Leave SPOTIFY_CLIENT_SECRET unset unless a future server-only feature needs it.

# Listening room (Spotify Web Playback SDK). Off unless exactly "true"; off, the site behaves exactly as before.
VITE_ENABLE_SPOTIFY_LISTENING_ROOM=false
# Public values, safe in the browser bundle. Use a separate "Melody Lust Dev" Spotify app for local work.
VITE_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered on that Spotify app exactly. Spotify refuses "localhost": use the loopback IP
# locally (http://127.0.0.1:<port>/auth/callback) and https://www.melodylust.fashion/auth/callback in production.
VITE_SPOTIFY_REDIRECT_URI=
