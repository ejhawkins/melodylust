# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase, browser side (Google sign-in and the browser client). Public values from
# Supabase > Project Settings > API: the project URL and the publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase, server side (sign-in checks on server functions). Same two values as above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase, server only, never VITE_ prefixed: the secret key that lets server functions read
# and write the database (artists, show notes, votes). SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Contentful (server-side only, never VITE_ prefixed): the space id and a Content Delivery API token, not the Preview token.
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_DELIVERY_TOKEN=your_delivery_token
# Optional, defaults to master.
CONTENTFUL_ENVIRONMENT=master
# Only for running scripts/contentful/seed-stories.ts: a personal Content Management token.
CONTENTFUL_MANAGEMENT_TOKEN=
