# Optional server-side integrations. Basic site and evidence API work without keys.
TUMBLR_CONSUMER_KEY=
LOVABLE_API_KEY=
MELODYLUST_AI_PROVIDER=gemini
GEMINI_API_KEY=
MELODYLUST_AI_MODEL=gemini-3.8-flash
MELODYLUST_PORT=3000
MELODYLUST_TRACKER_CSV=
MELODYLUST_DEBUG=0

# Artist directory: freqblog (paid plan), mock (fictional test data), or empty.
ARTIST_PROVIDER=
FREQBLOG_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use a long random value on each deployment; server-side only.
RATE_LIMIT_SALT=

# Runway Music Archive in Contentful (Settings → API keys). Without them the player plays the sampler alone.
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
# CONTENTFUL_ENVIRONMENT=master
